{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/MRHDesk.svg",
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "children": [
    {
      "id": "topbar",
      "type": "block",
      "size": {
        "px": 48
      },
      "window_drag": true,
      "content": {
        "mod": "mrh-topbar"
      }
    },
    {
      "id": "body",
      "type": "row",
      "resizable": false,
      "divider": {
        "width": 1,
        "color": "border"
      },
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 268
          },
          "min": 44,
          "max": 480,
          "background": "chrome",
          "resizable": false,
          "children": [
            {
              "id": "sidebar-lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "spaces"
                  }
                },
                {
                  "id": "docs",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 100,
                  "content": {
                    "mod": "mrh-docs"
                  }
                },
                {
                  "id": "agents",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "agents"
                  }
                }
              ]
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "size": {
                "px": 69
              },
              "content": {
                "mod": "workspace-chrome",
                "props": {
                  "footer": true
                }
              }
            }
          ]
        },
        {
          "id": "work",
          "type": "column",
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "px": 42
              },
              "window_drag": true,
              "content": {
                "mod": "mrh-tabs"
              }
            },
            {
              "id": "work-body",
              "type": "row",
              "padding": 8,
              "gap": 8,
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 8,
                      "radius": 10,
                      "background": "background",
                      "lone": false,
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "height": 28,
                        "position": "top",
                        "reveal": "hover"
                      }
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "hidden": true,
                  "size": {
                    "px": 360
                  },
                  "min": 280,
                  "max": 900,
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "active": "files",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "status",
              "type": "block",
              "size": {
                "px": 28
              },
              "content": {
                "mod": "workspace-status"
              }
            }
          ]
        }
      ]
    }
  ]
}
